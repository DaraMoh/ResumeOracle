# Copy this file to .env.local and fill in your keys.

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── OpenRouter (fallback when Gemini quota is hit) ────────────────────────────
# Free plan works. Get a key at https://openrouter.ai/keys
# Model chain: Gemma 4 → openrouter/auto
OPENROUTER_API_KEY=

# ── JSearch via RapidAPI (LinkedIn / Indeed / Glassdoor / ZipRecruiter) ───────
# Subscribe (free tier: 200 req/mo) at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# ── Adzuna (free job board API, fallback source) ──────────────────────────────
# Register at https://developer.adzuna.com/ — free tier: 250 req/day
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Country code for Adzuna results (us | gb | ca | au | de | fr | in …)
ADZUNA_COUNTRY=us
